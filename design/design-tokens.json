{
  "$description": "Naija Life design tokens (placeholder brand, original). Wire into Tailwind theme in Phase 1.",
  "color": {
    "primary":   { "50": "#E8F7EE", "100": "#C6ECD5", "300": "#5DC785", "500": "#1FA55B", "600": "#168A4B", "700": "#106B3B" },
    "accent":    { "100": "#FFE6D2", "400": "#FF9A4D", "500": "#F57A1F", "600": "#D8630F" },
    "ink":       { "900": "#141A22", "700": "#2B3440", "500": "#5B6675", "300": "#9AA4B2" },
    "cream":     { "50": "#FFFDF8", "100": "#F8F4EA", "200": "#EFE9DA" },
    "info":      { "100": "#DCEBFA", "500": "#2E7FD8" },
    "danger":    { "100": "#FDE1E4", "500": "#E23B52" },
    "warning":   { "100": "#FFF1C9", "500": "#E9A400" },
    "success":   { "100": "#D9F5E3", "500": "#1FA55B" },
    "needs": {
      "hunger": "#F59E3F", "energy": "#3B82F6", "fun": "#EAB308",
      "social": "#EC4899", "hygiene": "#14B8A6"
    },
    "surface": { "app": "#F8F4EA", "card": "#FFFFFF", "overlay": "rgba(20,26,34,0.55)" }
  },
  "font": {
    "display": "'Baloo 2', 'Nunito', system-ui, sans-serif",
    "ui": "'Plus Jakarta Sans', 'Nunito', system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "fontSize": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "18px", "xl": "22px", "2xl": "28px", "3xl": "36px" },
  "radius": { "sm": "8px", "md": "14px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px" },
  "shadow": {
    "card": "0 2px 8px rgba(20,26,34,0.08)",
    "sheet": "0 -8px 32px rgba(20,26,34,0.18)"
  },
  "motion": { "fast": "150ms", "base": "220ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "layout": { "minTapTarget": "44px", "designWidth": "390px", "maxContentWidth": "480px" }
}
